    "nspell": "^2.1.5",
    "papaparse": "^5.5.4"
  },
  "devDependencies": {
    "@fontsource/caladea": "^5.1.0",
    "@fontsource/carlito": "^5.1.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@wordinweb/agent": "file:../../../wordinweb-likeoffice/packages/agent",
    "electron": "34.5.8",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
